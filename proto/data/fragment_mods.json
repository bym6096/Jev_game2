{
 "rules": {
  "reverse": {
   "name": "반전",
   "text": "효과의 방향을 뒤집는다: 피해↔회복, 약화↔강화, 방어↔약화, 골드↔탈취, 채집↔재배, 더 뽑기↔폐기(그 밖의 동사는 그대로). 수치 ×0.9"
  },
  "bigger": {
   "name": "확대",
   "text": "범위를 한 단계 넓힌다(단일→둘→주변 무리→전체), 건물·소환물 체력 ×1.3, 수치 ×0.9, 마나 +1"
  },
  "smaller": {
   "name": "축소",
   "text": "범위를 한 단계 좁힌다(없으면 그대로), 수치 ×0.85, 마나 −1(최소 1)"
  },
  "faster": {
   "name": "신속",
   "text": "지연 효과의 지연을 없애고, 마나 −1(최소 1)"
  },
  "slower": {
   "name": "지연",
   "text": "즉발·시전은 2턴 뒤에 발동, 건물·소환물·지속 효과는 처음 2턴 동안 작동 안 함. 대신 수치 ×1.4"
  },
  "stronger": {
   "name": "강화",
   "text": "수치 ×1.4, 마나 +1"
  },
  "weaker": {
   "name": "약화",
   "text": "수치 ×0.7, 마나 −1(최소 1)"
  },
  "risky": {
   "name": "위험",
   "text": "수치 ×1.5, 쓸 때마다 나도 피해를 입는다(위험 속성 부여: 수치의 1/4)"
  },
  "random": {
   "name": "무작위",
   "text": "효과가 50~150% 사이로 매번 달라진다(무작위 속성 부여). 마나 −1(최소 1)"
  }
 },
 "twists": {
  "light": {
   "name": "경량",
   "text": "마나 −1(최소 1), 수치 ×0.85"
  },
  "rich": {
   "name": "농후",
   "text": "마나 +1, 수치 ×1.25"
  },
  "once": {
   "name": "한 방",
   "text": "수치 ×1.3, 한 번 쓰면 사라진다(1회용)"
  },
  "spread": {
   "name": "넓고 얕게",
   "text": "범위를 한 단계 넓히고(이미 전체면 그대로) 수치 ×0.8"
  }
 },
