 "combos": {
  "불|재생": {
   "name": "불사의 불꽃",
   "desc": "매 턴 체력을 되찾고 화상이 옆 적에게 번진다",
   "from": "불 + 재생"
  },
  "얼음|화상": {
   "name": "열충격",
   "desc": "뜨겁고 차가운 것이 부딪쳐 적의 방어가 깨진다",
   "from": "얼음 + 화상"
  },
  "번개|연쇄": {
   "name": "연쇄 번개",
   "desc": "번개가 모든 적을 한 번씩 건너뛰며 때린다",
   "from": "번개 + 연쇄"
  },
  "독|흡혈": {
   "name": "독 흡수",
   "desc": "적의 중독을 먹어 체력으로 바꾼다",
   "from": "독 + 흡혈"
  },
  "물|정화": {
   "name": "샘물",
   "desc": "나쁜 상태를 모두 씻고 마나를 1 얻는다",
   "from": "물 + 정화"
  },
  "빛|부활": {
   "name": "성스러운 부활",
   "desc": "일어날 때 체력이 가득 차고 적을 눈멀게 한다",
   "from": "빛 + 부활"
  },
  "어둠|은신": {
   "name": "그림자 숨바꼭질",
   "desc": "숨은 동안 첫 공격이 두 배가 된다",
   "from": "어둠 + 은신"
  },
  "시간|되감기": {
   "name": "시간 역행",
   "desc": "되감을 때 쓴 마나를 돌려받는다",
   "from": "시간 + 되감기"
  },
  "시간|가속": {
   "name": "가속 시계",
   "desc": "한 번 더 행동하고 다음 구슬이 공짜가 된다",
   "from": "시간 + 가속"
  },
  "돈|도박": {
   "name": "빚쟁이의 도박",
   "desc": "크게 잃으면 외상으로 한 번 더 걸 수 있다",
   "from": "돈 + 도박"
  },
  "돈|황금": {
   "name": "황금 폭포",
   "desc": "얻는 돈이 두 배가 된다",
   "from": "돈 + 황금"
  },
  "음식|회복": {
   "name": "든든한 한 끼",
   "desc": "회복한 만큼 최대 체력이 오른다",
   "from": "음식 + 회복"
  },
  "꿈|예지": {
   "name": "예지몽",
   "desc": "다음 구슬 세 개를 보고 하나를 골라 뽑는다",
   "from": "꿈 + 예지"
  },
  "영혼|소환": {
   "name": "영혼 소환",
   "desc": "쓰러진 동료가 영혼으로 돌아와 함께 싸운다",
   "from": "영혼 + 소환"
  },
  "뼈|부활": {
   "name": "해골 기사",
   "desc": "쓰러져도 뼈로 일어나 한 번 더 때린다",
   "from": "뼈 + 부활"
  },
  "바람|회피": {
   "name": "바람처럼",
   "desc": "피한 공격만큼 다음 공격이 세진다",
   "from": "바람 + 회피"
  },
  "강철|반격": {
   "name": "철벽 반격",
   "desc": "맞을 때마다 방어가 늘고 되받는 피해도 커진다",
   "from": "강철 + 반격"
  },
  "소리|혼란": {
   "name": "불협화음",
   "desc": "적이 서로의 귀를 막고 서로를 때린다",
   "from": "소리 + 혼란"
  },
  "중력|봉인": {
   "name": "중력 감옥",
   "desc": "봉인된 구슬은 이번 전투 내내 풀리지 않는다",
   "from": "중력 + 봉인"
  },
  "웃음|혼란": {
   "name": "웃음 바이러스",
   "desc": "웃음이 옆 적에게 번져 모두 행동이 흐트러진다",
   "from": "웃음 + 혼란"
  },
  "운|도박": {
   "name": "행운의 도박",
   "desc": "도박에서 지는 일이 한 번 없어진다",
   "from": "운 + 도박"
  },
  "기억|회수": {
   "name": "회상",
   "desc": "되찾은 구슬의 마나가 줄어든다",
   "from": "기억 + 회수"
  },
  "언어|봉인": {
   "name": "금기어",
   "desc": "봉인한 적은 다음 효과도 말하지 못한다",
   "from": "언어 + 봉인"
  },
  "전쟁|분노": {
   "name": "전쟁광",
   "desc": "맞을 때마다 모든 구슬이 강해진다",
   "from": "전쟁 + 분노"
  },
  "잠|휴식": {
   "name": "깊은 잠",
   "desc": "쉬는 동안 모든 나쁜 상태가 풀리고 구슬을 두 개 뽑는다",
   "from": "잠 + 휴식"
  },
  "사랑|도발": {
   "name": "연모",
   "desc": "적이 나만 쳐다보다 자기 편을 놓친다",
   "from": "사랑 + 도발"
  },
  "균|중독": {
   "name": "포자 번식",
   "desc": "중독이 번질 때마다 작은 동료가 하나 생긴다",
   "from": "균 + 중독"
  },
  "유리|가시": {
   "name": "유리 파편",
   "desc": "가시가 박히면 적의 방어가 깎인다",
   "from": "유리 + 가시"
  }
 },
